# Copie para .env (que NÃO vai para o Git) e preencha.

# Provedor principal de IA
GROQ_API_KEY=cole_sua_chave_aqui
GROQ_MODEL=openai/gpt-oss-20b

# Alternativa (fallback). Sem prefixo "gemini/": o código monta a URL da API direto.
GEMINI_API_KEY=cole_sua_chave_aqui
GEMINI_MODEL=gemini-2.5-flash

# --- Conexões com contas externas (opcional) ---
# Onde ficam o banco de tokens criptografado e a chave. Fora do repositório.
# Padrão: ~/.jarvis
# JARVIS_DATA_DIR=

# URL pública do backend, usada no redirect do OAuth.
# JARVIS_BACKEND_URL=http://localhost:8000

# Origens do frontend autorizadas a chamar rotas sensíveis (separadas por vírgula).
# JARVIS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Client ID/secret do Google podem ser definidos pela tela de admin (Alt+Shift+A),
# que guarda criptografado. Estas variáveis são só um atalho opcional:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Motor de cenas (opcional) ---
# Vídeos do YouTube (embed, SafeSearch estrito). Sem a chave, usa só Wikimedia Commons.
YOUTUBE_API_KEY=
# Desliga a busca de imagens/vídeos (true/false)
MEDIA_ENABLED=true

# --- Ações no computador, visão de tela e voz sem clique (opcional) ---
# Desligar partes: 0 desliga
# JARVIS_ACTIONS_ENABLED=1
# JARVIS_VISION_ENABLED=1
# JARVIS_VOICE_ENABLED=1

# Layout ao abrir um programa: o programa ocupa esta fração da largura (padrão 0.667 = 2/3) e o Jarvis o resto.
# JARVIS_APP_RATIO=0.667
# auto: 1 monitor divide; 2+ monitores dedicam um monitor ao Jarvis. split | dedicated força.
# JARVIS_LAYOUT_MODE=auto
# Em qual monitor o Jarvis fica (0, 1...) quando há mais de um. Padrão: o primeiro que não é o principal.
# JARVIS_MONITOR=

# Janelas que o Jarvis NUNCA captura (expressão regular). Substitui a lista padrão (bancos, senhas).
# JARVIS_BLOCKED_WINDOWS=senha|password|nubank|itau|bradesco

# Voz: tamanho do modelo Whisper (tiny, base, small, medium). small é um bom equilíbrio no CPU.
# JARVIS_WHISPER_MODEL=small
# cpu | cuda | auto  e  int8 | float16 | auto (com placa NVIDIA: JARVIS_WHISPER_DEVICE=cuda JARVIS_WHISPER_COMPUTE=float16)
# JARVIS_WHISPER_DEVICE=auto
# JARVIS_WHISPER_COMPUTE=int8
# JARVIS_WAKE_WORD=jarvis

# Análise de gráficos: deixe o Gemini "pensar" um pouco (mais lento, melhor). 0 = rápido.
# GEMINI_VISION_THINKING=0
# Modelo só para as imagens (padrão: o mesmo do GEMINI_MODEL)
# GEMINI_VISION_MODEL=

# HUD em janela de app: navegador (padrão chrome, depois edge) e caminho manual se preciso
# JARVIS_BROWSER_ORDER=chrome,edge
# JARVIS_BROWSER=
