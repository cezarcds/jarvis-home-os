# Copie para .env (que NÃO vai para o Git) e preencha.

# Provedor principal de IA
GROQ_API_KEY=cole_sua_chave_aqui
GROQ_MODEL=openai/gpt-oss-20b

# Alternativa (fallback). Sem prefixo "gemini/": o código monta a URL da API direto.
GEMINI_API_KEY=cole_sua_chave_aqui
GEMINI_MODEL=gemini-2.5-flash

# --- Conexões com contas externas (opcional) ---
# Onde ficam o banco de tokens criptografado e a chave. Fora do repositório.
# Padrão: ~/.jarvis
# JARVIS_DATA_DIR=

# URL pública do backend, usada no redirect do OAuth.
# JARVIS_BACKEND_URL=http://localhost:8000

# Origens do frontend autorizadas a chamar rotas sensíveis (separadas por vírgula).
# JARVIS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Client ID/secret do Google podem ser definidos pela tela de admin (Alt+Shift+A),
# que guarda criptografado. Estas variáveis são só um atalho opcional:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Motor de cenas (opcional) ---
# Vídeos do YouTube (embed, SafeSearch estrito). Sem a chave, usa só Wikimedia Commons.
YOUTUBE_API_KEY=
# Desliga a busca de imagens/vídeos (true/false)
MEDIA_ENABLED=true
