+    assert asyncio.run(tick(ag)) == 1 and len(mundo.chamadas["t.gerar"]) == 1
+    assert asyncio.run(tick(ag)) == 0                                    # mesmo minuto: não repete
+    r.t += 60
+    assert asyncio.run(tick(ag)) == 0
+    assert asyncio.run(tick(novo(r))) == 0                               # "reiniciou": não repete
