+
+async def tick(ag):
+    tasks = await ag.tick()
+    if tasks:
+        await asyncio.gather(*tasks)
+    return len(tasks)
+
+
+def novo(relogio):
+    return agendador.Agendador(relogio=relogio, dormir=sem_espera)
