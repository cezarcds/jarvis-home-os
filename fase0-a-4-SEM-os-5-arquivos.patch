+    monkeypatch.setattr(gate, "Contexto", contexto_ja_parado)
+    out = asyncio.run(engine.run_routine(_rotina("agenda.hoje"), "s1"))
+    assert chamou == [] and out["blocos"][0]["data"]["mensagem"] == "Interrompido"
