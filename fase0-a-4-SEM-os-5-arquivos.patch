+++ b/backend/capacidades/navegador.py
@@ -0,0 +1,156 @@
+"""Navegador do Jarvis (Playwright) com perfil PRÓPRIO e rede restrita a uma allowlist de domínios.
+
+- Perfil em ~/.jarvis/browser-profile, separado do seu navegador pessoal (AGENTE.md, seção 8).
+- TODA requisição da página (documento, imagem, script, cada salto de redirecionamento) passa por um
+  filtro de rede: host fora da lista é abortado ANTES de sair da máquina. Depois de carregar, a URL final é conferida de novo.
+- Só http/https; sem downloads; timeout curto; o texto devolvido é truncado e redigido.
+- O botão PARAR fecha o navegador (gancho do gate), além do cancelamento normal da tarefa.
+"""
+from __future__ import annotations
+
+import asyncio
+import logging
+import threading
+from typing import Any, Dict, List, Optional, Tuple
+from urllib.parse import urljoin, urlparse
+
+from actions import gate
+from actions.redact import redigir_saida
+from connections.config import data_dir
+from routines.tools.registry import ToolError
+from tarefas.contrato import dominio_ok
+
+log = logging.getLogger("jarvis.navegador")
+
+TIMEOUT_NAVEGACAO_MS = 20_000
+TEXTO_MAX = 3000
+MAX_SALTOS = 5
+_ativos: List[Tuple[asyncio.AbstractEventLoop, Any]] = []
+_trava = threading.Lock()
+_ocupado = False
+_gancho_registrado = False
+
+
+def disponivel() -> Tuple[bool, str]:
+    try:
+        import playwright  # noqa: F401
+    except ImportError:
+        return False, "Instale o Playwright (pip install playwright; playwright install chromium)"
+    return True, ""
+
+
+def perfil() -> str:
+    p = data_dir() / "browser-profile"
+    p.mkdir(parents=True, exist_ok=True)
+    return str(p)
+
+
+def url_ok(url: str, permitidos: List[str]) -> Optional[str]:
+    """None se a URL pode ser aberta; senão, o motivo (em português)."""
+    try:
+        u = urlparse(url)
+    except ValueError:
+        return "Endereço inválido."
+    if u.scheme not in ("http", "https") or not u.hostname:
+        return "Só endereços http e https são permitidos."
+    if u.username or u.password:
+        return "Endereço com usuário/senha não é permitido."
+    if not permitidos:
+        return "Nenhum domínio está permitido para o navegador."
+    if not dominio_ok(url, permitidos):
+        return f"O domínio «{u.hostname}» não está entre os permitidos."
+    return None
+
+
+def _fechar_tudo_do_gancho() -> None:
+    """Gancho do botão PARAR: pode vir de outra thread; pede o fechamento no loop de cada navegador."""
+    with _trava:
+        ativos = list(_ativos)
+    for loop, ctx in ativos:
+        try:
+            asyncio.run_coroutine_threadsafe(ctx.close(), loop)
+        except Exception:  # noqa: BLE001 - o loop pode já ter acabado
+            pass
+
+
+async def abrir(url: str, permitidos: List[str]) -> Dict[str, Any]:
+    global _ocupado, _gancho_registrado
+    motivo = url_ok(url, permitidos)
+    if motivo:
+        raise ToolError(motivo)
+    if _ocupado:
+        raise ToolError("O navegador do Jarvis já está em uso.")
+    from playwright.async_api import Error as PwError, async_playwright
+
+    if not _gancho_registrado:
+        gate.registrar_gancho_parada(_fechar_tudo_do_gancho)
+        _gancho_registrado = True
+    _ocupado = True
+    bloqueados: List[str] = []
+    try:
+        async with async_playwright() as pw:
+            ctx = await pw.chromium.launch_persistent_context(
+                perfil(), headless=True, accept_downloads=False, service_workers="block",
+                args=["--disable-extensions", "--no-first-run"])
+            with _trava:
+                _ativos.append((asyncio.get_running_loop(), ctx))
+            try:
+                final_doc: Dict[str, str] = {}
+
+                async def filtro(route):
+                    """Decide cada requisição. Redirecionamentos são resolvidos AQUI, salto a salto, porque o
+                    Chromium segue 3xx por dentro da rede sem repassar o destino ao filtro."""
+                    req = route.request
+                    alvo = req.url
+                    if alvo.startswith(("data:", "blob:", "about:")):
+                        await route.continue_()
+                        return
+                    for _salto in range(MAX_SALTOS + 1):
+                        if url_ok(alvo, permitidos) is not None:
+                            bloqueados.append(urlparse(alvo).hostname or alvo[:40])
+                            await route.abort("blockedbyclient")
+                            return
+                        try:
+                            resp = await route.fetch(url=alvo, max_redirects=0)
+                        except PwError:
+                            await route.abort("failed")
+                            return
+                        destino = resp.headers.get("location")
+                        if resp.status in (301, 302, 303, 307, 308) and destino:
+                            alvo = urljoin(alvo, destino)
+                            continue
+                        if req.is_navigation_request() and req.frame == page_ref[0].main_frame:
+                            final_doc["url"] = alvo
+                        await route.fulfill(response=resp)
+                        return
+                    bloqueados.append("redirecionamentos demais")
+                    await route.abort("failed")
+
+                page_ref: List[Any] = []
+                await ctx.route("**/*", filtro)
+                page = ctx.pages[0] if ctx.pages else await ctx.new_page()
+                page_ref.append(page)
+                page.set_default_timeout(TIMEOUT_NAVEGACAO_MS)
+                try:
+                    resp = await page.goto(url, wait_until="load", timeout=TIMEOUT_NAVEGACAO_MS)
+                except PwError as exc:
+                    if bloqueados:
+                        raise ToolError(f"A página tentou sair da allowlist ({bloqueados[0]}); bloqueado.") from exc
+                    raise ToolError(f"Não consegui abrir a página: {str(exc).splitlines()[0][:150]}") from exc
+                final = final_doc.get("url") or page.url
+                motivo = url_ok(final, permitidos)
+                if motivo:
+                    raise ToolError(f"A página terminou fora da allowlist: {motivo}")
+                titulo = await page.title()
+                texto = await page.evaluate("() => (document.body ? document.body.innerText : '')")
+                status = resp.status if resp else None
+            finally:
+                with _trava:
+                    _ativos[:] = [a for a in _ativos if a[1] is not ctx]
+                await ctx.close()
+    finally:
+        _ocupado = False
+    texto = redigir_saida(texto, TEXTO_MAX)
+    return {"type": "pagina", "title": titulo or final,
+            "data": {"url": final, "titulo": titulo, "status": status, "texto": texto, "bloqueados": sorted(set(bloqueados))},
+            "falado": f"Abri {titulo or final}.", "resumo_llm": f"Página «{titulo}» ({final}): {texto[:600]}"}
diff --git a/backend/capacidades/processos.py b/backend/capacidades/processos.py
new file mode 100644
index 00000000..afd65ab3
--- /dev/null
+++ b/backend/capacidades/processos.py
@@ -0,0 +1,84 @@
+"""Processos filhos do Jarvis: rodar sem shell, com timeout, e matar a ÁRVORE inteira.
+
+Os processos vivos ficam registrados aqui para o botão PARAR (gancho do gate) matar mesmo quando a
+thread/tarefa que os esperava já foi cancelada.
+"""
+from __future__ import annotations
+
+import asyncio
+import os
+import signal
+import subprocess
+import sys
+import threading
+from typing import Dict, List, Optional, Tuple
+
+_vivos: Dict[int, "asyncio.subprocess.Process"] = {}
+_trava = threading.Lock()
+SAIDA_MAX = 4000
+
+_ENV_BASICO = ("PATH", "PATHEXT", "SYSTEMROOT", "WINDIR", "COMSPEC", "TEMP", "TMP", "TMPDIR", "HOME",
+               "USERPROFILE", "APPDATA", "LOCALAPPDATA", "PROGRAMDATA", "PROGRAMFILES", "PROGRAMFILES(X86)",
+               "LANG", "LC_ALL")
+
+
+def ambiente_minimo() -> Dict[str, str]:
+    """Só o essencial para o programa achar o Python/Node: nenhuma chave de API do Jarvis vaza."""
+    return {k: v for k, v in os.environ.items() if k.upper() in _ENV_BASICO}
+
+
+def _matar_pid(pid: int) -> None:
+    try:
+        if sys.platform == "win32":
+            subprocess.run(["taskkill", "/PID", str(pid), "/T", "/F"], capture_output=True, timeout=10,
+                           creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
+        else:
+            os.killpg(os.getpgid(pid), signal.SIGKILL)
+    except (OSError, subprocess.SubprocessError):
+        try:
+            os.kill(pid, signal.SIGKILL)
+        except OSError:
+            pass
+
+
+def matar_todos() -> int:
+    """Gancho do botão PARAR: mata a árvore de cada processo registrado."""
+    with _trava:
+        pids = list(_vivos)
+    for pid in pids:
+        _matar_pid(pid)
+    return len(pids)
+
+
+async def rodar(argv: List[str], cwd: str, timeout_s: float,
+                ambiente: Optional[Dict[str, str]] = None) -> Tuple[int, str, bool]:
+    """Roda `argv` sem shell. Devolve (código, saída truncada, estourou_o_tempo).
+    No timeout ou cancelamento, a árvore de processos inteira é encerrada."""
+    kw: dict = {}
+    if sys.platform == "win32":
+        kw["creationflags"] = getattr(subprocess, "CREATE_NO_WINDOW", 0) | getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0)
+    else:
+        kw["start_new_session"] = True
+    proc = await asyncio.create_subprocess_exec(
+        *argv, cwd=cwd, env=ambiente if ambiente is not None else ambiente_minimo(),
+        stdin=asyncio.subprocess.DEVNULL, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT, **kw)
+    with _trava:
+        _vivos[proc.pid] = proc
+    estourou = False
+    try:
+        try:
+            bruto, _ = await asyncio.wait_for(proc.communicate(), timeout=timeout_s)
+        except asyncio.TimeoutError:
+            estourou = True
+            _matar_pid(proc.pid)
+            bruto, _ = await proc.communicate()
+        texto = (bruto or b"").decode("utf-8", errors="replace")
+        return proc.returncode if proc.returncode is not None else -1, texto[-SAIDA_MAX:], estourou
+    except asyncio.CancelledError:
+        _matar_pid(proc.pid)
+        raise
+    finally:
+        with _trava:
+            _vivos.pop(proc.pid, None)
+        if proc.returncode is None:
+            _matar_pid(proc.pid)
diff --git a/backend/capacidades/tools.py b/backend/capacidades/tools.py
new file mode 100644
index 00000000..5d5a4f41
--- /dev/null
+++ b/backend/capacidades/tools.py
@@ -0,0 +1,139 @@
+"""Ferramentas da Fase 3: comando.rodar, vscode.abrir_projeto, navegador.abrir.
+
+Todas são nível 1 (ação local) e só rodam pelo gate. Nenhuma aceita texto livre que vire comando:
+o que roda vem do catálogo (comandos.json), o que abre vem de uma pasta cadastrada, e o navegador
+só chega a domínios permitidos (escopo.dominios do contrato). Todas são `somente_tarefa`: o gate recusa
+fora de uma tarefa com contrato.
+"""
+from __future__ import annotations
+
+import asyncio
+import os
+import re
+import shutil
+import sys
+from pathlib import Path
+from typing import Any, Dict, List, Tuple
+from urllib.parse import urlparse
+
+from actions import gate
+from actions.redact import redigir_saida
+from routines.tools.registry import Param, ToolError, tool
+
+from . import catalogo, navegador, processos
+
+_CHARS_PERIGOSOS = re.compile(r'[&|<>^%"\r\n`]')  # .cmd no Windows passa por cmd.exe: nada disso entra
+
+
+def _resultado(titulo: str, dados: Dict[str, Any], falado: str, resumo: str = "") -> Dict[str, Any]:
+    return {"type": "acao", "title": titulo, "data": dados, "falado": falado, "resumo_llm": resumo or falado}
+
+
+# ---- comando.rodar ---------------------------------------------------------------------------------
+
+def _argv_do_comando(nome: str, quantidade: Any) -> Tuple[catalogo.Comando, List[str]]:
+    c = catalogo.comando(nome)
+    valores: Dict[str, str] = {}
+    if quantidade is not None and "quantidade" not in c.params:
+        raise ToolError(f"O comando «{nome}» não aceita «quantidade».")
+    for k, spec in c.params.items():
+        v = quantidade if quantidade is not None else spec.get("default")
+        if v is None:
+            raise ToolError(f"O comando «{nome}» precisa de «{k}».")
+        try:
+            v = int(v)
+        except (TypeError, ValueError):
+            raise ToolError(f"«{k}» precisa ser um número inteiro.") from None
+        if not spec["min"] <= v <= spec["max"]:
+            raise ToolError(f"«{k}» precisa ficar entre {spec['min']} e {spec['max']} (veio {v}).")
+        valores[k] = str(v)
+    argv = [catalogo.PLACEHOLDER.sub(lambda m: valores[m.group(1)], a) for a in c.exec]
+    return c, argv
+
+
+def _alvos_comando(params: Dict[str, Any]) -> Dict[str, Any]:
+    c = catalogo.comando(params.get("nome"))
+    return {"pasta": c.pasta}  # o contrato confere onde o comando vai rodar
+
+
+def _confirma_comando(params: Dict[str, Any]) -> str:
+    return f"Rodar o comando «{params.get('nome')}»."
+
+
+@tool("comando.rodar", "rodar comando cadastrado",
+      "Roda um comando NOMEADO do catálogo (~/.jarvis/comandos.json) na pasta do projeto dele. "
+      "Nunca aceita texto livre: só o nome e, se o catálogo previr, a quantidade.",
+      params=[Param("nome", "str", None, "nome do comando no catálogo"),
+              Param("quantidade", "int", None, "quantidade, se o comando aceitar")],
+      risco="acao_local", timeout=4 * 3600 + 30.0, confirmacao=_confirma_comando, alvos=_alvos_comando,
+      somente_tarefa=True)
+async def comando_rodar(nome=None, quantidade=None):
+    c, argv = _argv_do_comando(nome, quantidade)  # revalida: não confia que o gate já olhou o catálogo
+    if shutil.which(argv[0]) is None and not Path(argv[0]).exists():
+        raise ToolError(f"O programa «{argv[0]}» do comando «{nome}» não foi encontrado.")
+    try:
+        codigo, saida, estourou = await processos.rodar(argv, c.pasta, c.timeout_s)
+    except OSError as exc:
+        raise ToolError(f"Não consegui iniciar «{nome}»: {exc.strerror or exc}") from exc
+    saida = redigir_saida(saida)
+    if estourou:
+        raise ToolError(f"O comando «{nome}» passou de {c.timeout_s}s e foi encerrado.")
+    if codigo != 0:
+        fim = saida.strip().splitlines()[-3:]
+        raise ToolError(f"O comando «{nome}» terminou com erro (código {codigo}). {' | '.join(fim)}"[:500])
+    return _resultado("Comando", {"nome": nome, "codigo": codigo, "saida": saida, "pasta": c.pasta},
+                      f"Comando {nome} concluído.", f"O comando {nome} terminou sem erro.")
+
+
+# ---- vscode.abrir_projeto --------------------------------------------------------------------------
+
+def _achar_vscode(cat: catalogo.Catalogo) -> str:
+    if cat.vscode and Path(cat.vscode).exists():
+        return cat.vscode
+    achado = shutil.which("code")
+    if not achado:
+        raise ToolError("Não achei o VS Code (comando «code»). Cadastre \"vscode\" no catálogo.")
+    return achado
+
+
+@tool("vscode.abrir_projeto", "abrir projeto no VS Code",
+      "Abre no VS Code uma pasta de projeto cadastrada no catálogo (~/.jarvis/comandos.json).",
+      params=[Param("pasta", "str", None, "caminho completo da pasta do projeto")],
+      risco="acao_local", timeout=30.0, somente_tarefa=True)
+async def vscode_abrir_projeto(pasta=None):
+    cat = catalogo.carregar()
+    real = catalogo.projeto_por_pasta(pasta or "")
+    if real is None or not pasta or _CHARS_PERIGOSOS.search(real):
+        raise ToolError("Essa pasta não está entre os projetos cadastrados.")
+    if not Path(real).is_dir():
+        raise ToolError("A pasta do projeto não existe.")
+    exe = _achar_vscode(cat)
+    codigo, saida, estourou = await processos.rodar([exe, real], real, 20)
+    if estourou or codigo != 0:
+        raise ToolError(f"O VS Code não abriu o projeto (código {codigo}).")
+    nome = Path(real).name
+    return _resultado("VS Code", {"pasta": real}, f"Projeto {nome} aberto no VS Code.")
+
+
+# ---- navegador.abrir -------------------------------------------------------------------------------
+
+def _disponivel_navegador() -> Tuple[bool, str]:
+    return navegador.disponivel()
+
+
+def _dominios_permitidos() -> List[str]:
+    contrato = gate.contrato_atual()
+    if contrato is None:  # o gate já recusa fora de tarefa; isto é a segunda trava
+        raise ToolError("O navegador só abre páginas dentro de uma tarefa com contrato.")
+    return list(contrato.c.escopo.dominios)
+
+
+@tool("navegador.abrir", "abrir página no navegador",
+      "Abre uma página num navegador próprio (perfil separado do seu) e devolve título e texto. "
+      "Só domínios permitidos; qualquer pedido de rede para fora da lista é bloqueado.",
