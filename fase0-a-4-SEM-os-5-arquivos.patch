+
+    async def fn(**p):
+        chamou.append(1)
+        return {"type": "agenda", "title": "A", "data": {}, "falado": "x", "resumo_llm": "x"}
+
+    monkeypatch.setattr(REGISTRY["agenda.hoje"], "check", None)
+    monkeypatch.setattr(REGISTRY["agenda.hoje"], "fn", fn)
